
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a student user within the CampusCycle platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (UID)."
        },
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "collegeName": {
          "type": "string"
        },
        "courseYear": {
          "type": "string"
        },
        "profilePhotoUrl": {
          "type": "string",
          "format": "uri"
        },
        "isVerified": {
          "type": "boolean"
        },
        "averageRating": {
          "type": "number"
        },
        "joinedDate": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "fullName",
        "email",
        "collegeName",
        "isVerified",
        "joinedDate",
        "role"
      ]
    },
    "ProductListing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductListing",
      "type": "object",
      "description": "Represents a single second-hand item posted for sale.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "description": "The URL of the product image."
        },
        "category": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "description": "Reference to the seller's UID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "Current status: pending, approved, or sold."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "price",
        "image",
        "category",
        "userId",
        "createdAt",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/product_listings/{listingId}": {
      "schema": "ProductListing",
      "description": "Marketplace items."
    }
  }
}
