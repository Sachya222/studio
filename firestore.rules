rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment poke to ensure immediate update and propagation of new rules.
    // Updated at: 2024-05-24T12:00:00Z

    // product listings
    match /product_listings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // users (optional)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}