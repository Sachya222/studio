rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment poke: 2024-05-24T21:15:00Z

    // product listings - Publicly readable with query limits, authenticated write
    match /product_listings/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow write: if request.auth != null;
    }

    // users profiles - Authenticated access only
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // admin roles
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}