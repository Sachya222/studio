rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment poke to ensure immediate update and propagation of new rules.
    // Updated at: 2024-05-24T19:15:00Z

    // product listings
    match /product_listings/{listingId} {
      // Allow everyone to view individual items and list the collection
      allow get, list: if true;
      
      // Allow creation for any authenticated student
      allow create: if request.auth != null;
      
      // Allow updates/deletes only for the owner or an admin
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // users profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // admin roles for the approval system
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}