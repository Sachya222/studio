rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standard marketplace structure: /product_listings/{id}
    // Standard profile structure: /users/{userId}

    match /product_listings/{id} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }

    // Standard poke for deployment: 2024-05-24T22:30:00Z
  }
}