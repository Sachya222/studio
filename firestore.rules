rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deployment poke: 2024-05-24T20:45:00Z

    // product listings - Publicly readable, authenticated write
    match /product_listings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // users profiles - Authenticated access only
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // admin roles (if used)
    match /roles_admin/{userId} {
      allow read: if request.auth != null;
    }
  }
}