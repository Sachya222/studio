
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isParticipant(participantIds) {
      return isSignedIn() && (request.auth.uid in participantIds);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    // Security Rules Deployment Poke: 2024-05-20 15:45:00
    // Standardizing user profile access
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isAdmin();
    }

    match /product_listings/{listingId} {
      // Unified list rule for marketplace browsing, ownership checks, and admin review.
      // Every document in the result set must satisfy one of these conditions.
      allow list: if request.query.limit <= 50 && (
        resource.data.status == 'approved' || 
        (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
        isAdmin()
      );

      // Individual document access
      allow get: if resource.data.status == 'approved' || isExistingOwner(resource.data.sellerId) || isAdmin();
      
      // Creations start as 'pending' for admin review
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid && request.resource.data.status == 'pending';
      
      // Updates are restricted to owners (status locked) or admins
      allow update: if (isExistingOwner(resource.data.sellerId) && request.resource.data.status == resource.data.status) || isAdmin();
      
      allow delete: if isExistingOwner(resource.data.sellerId) || isAdmin();
    }

    match /chat_threads/{chatThreadId} {
      allow get, list: if isParticipant(resource.data.participantIds);
      allow create: if isSignedIn() && isParticipant(request.resource.data.participantIds);
      allow update: if isParticipant(resource.data.participantIds);
      allow delete: if isAdmin();
    }

    match /chat_threads/{chatThreadId}/messages/{messageId} {
      allow get, list: if isParticipant(resource.data.participantIds);
      allow create: if isParticipant(request.resource.data.participantIds) && request.resource.data.senderId == request.auth.uid;
      allow update: if false; 
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update: if false; 
      allow delete: if isExistingOwner(resource.data.reviewerId) || isAdmin();
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
